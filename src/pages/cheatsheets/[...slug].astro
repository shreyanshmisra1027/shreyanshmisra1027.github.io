---
import { getCollection } from 'astro:content';
import DocumentationLayout from '../../layouts/DocumentationLayout.astro';

export async function getStaticPaths() {
  const cheatsheets = await getCollection('cheatsheets', ({ data }) => !data.draft);

  return cheatsheets.map((entry) => {
    // entry.slug might be 'python-fundamentals' or 'programming/python-fundamentals'
    const parts = entry.slug.split('/');
    // If slug has multiple parts, e.g., 'programming/python-fundamentals'
    const category = entry.data.category;
    const subcategory = [...parts].pop() ?? entry.slug;

    return {
      params: { slug: [category, subcategory].join('/') },
      props: { entry },
    };
  });
}

const { entry } = Astro.props;
const { Content, headings } = await entry.render();

// Compute previous and next cheatsheets in the same category
const allCategoryCheatsheets = await getCollection(
  'cheatsheets',
  ({ data }) => !data.draft && data.category === entry.data.category
);

allCategoryCheatsheets.sort(
  (a, b) => (a.data.order || 99) - (b.data.order || 99) || a.data.title.localeCompare(b.data.title)
);

const currentIndex = allCategoryCheatsheets.findIndex((c) => c.slug === entry.slug);
const prevEntry = currentIndex > 0 ? allCategoryCheatsheets[currentIndex - 1] : null;
const nextEntry = currentIndex < allCategoryCheatsheets.length - 1 ? allCategoryCheatsheets[currentIndex + 1] : null;

const formatSlug = (slug: string) => slug.split('/').pop() || slug;

const prev = prevEntry
  ? {
      title: prevEntry.data.title,
      href: `/cheatsheets/${prevEntry.data.category}/${formatSlug(prevEntry.slug)}/`,
    }
  : undefined;

const next = nextEntry
  ? {
      title: nextEntry.data.title,
      href: `/cheatsheets/${nextEntry.data.category}/${formatSlug(nextEntry.slug)}/`,
    }
  : undefined;
---

<DocumentationLayout
  title={entry.data.title}
  description={entry.data.description}
  category={entry.data.category}
  subcategory={entry.data.subcategory}
  difficulty={entry.data.difficulty}
  dateUpdated={entry.data.dateUpdated || entry.data.dateCreated}
  tags={entry.data.tags}
  slug={entry.slug}
  headings={headings}
  prev={prev}
  next={next}
>
  <Content />
</DocumentationLayout>
