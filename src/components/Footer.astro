---
import { Github } from 'lucide-astro';
---
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-left">
      <p>© ${new Date().getFullYear()} CODEDEX. All rights reserved.</p>
    </div>
    <div class="footer-right">
      <a href="/about" class="footer-link">About</a>
      <a href="https://github.com/shreyanshmisra1027/shreyanshmisra1027.github.io" target="_blank" rel="noopener noreferrer" class="footer-link icon-link" aria-label="GitHub Repository">
        <Github size={18} />
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--surface);
    border-top: 1px solid var(--border);
    padding: 1.5rem 0;
    margin-top: auto;
    color: var(--text-secondary);
    font-size: 0.875rem;
  }
  .footer-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .footer-link {
    color: var(--text-secondary);
    margin-left: 1rem;
    transition: color var(--transition);
  }
  .footer-link:hover {
    color: var(--text-primary);
  }
  .icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.35rem;
    border-radius: var(--radius);
  }
</style>