---
import { ArrowUpRight } from 'lucide-astro';

interface Props {
  title: string;
  description: string;
  category: string;
  subcategory: string;
  slug: string;
  difficulty?: string;
  tags?: string[];
}

const { title, description, category, subcategory, slug, difficulty, tags = [] } = Astro.props;
const cleanSlug = slug.includes('/') ? slug.split('/').pop() : slug;
const href = `/cheatsheets/${category}/${cleanSlug}/`;
---

<a href={href} class="cheatsheet-card">
  <div class="card-header">
    <div class="card-badges">
      <span class="card-category">{category}</span>
      <span class="card-subcategory">{subcategory}</span>
    </div>
    <ArrowUpRight size={16} class="card-arrow" />
  </div>

  <h3 class="card-title">{title}</h3>
  <p class="card-description">{description}</p>

  {tags.length > 0 && (
    <div class="card-footer">
      <div class="card-tags">
        {tags.slice(0, 3).map((tag) => (
          <span class="card-tag">#{tag}</span>
        ))}
      </div>
      {difficulty && <span class={`card-diff ${difficulty}`}>{difficulty}</span>}
    </div>
  )}
</a>

<style>
  .cheatsheet-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    text-decoration: none;
    transition: all var(--transition);
  }

  .cheatsheet-card:hover {
    background-color: var(--surface-hover);
    border-color: var(--text-muted);
    transform: translateY(-2px);
  }

  .cheatsheet-card:hover .card-arrow {
    transform: translate(2px, -2px);
    color: var(--text-primary);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .card-badges {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .card-category {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--text-primary);
    background-color: var(--surface-elevated);
    border: 1px solid var(--border);
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }

  .card-subcategory {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-muted);
  }

  .card-arrow {
    color: var(--text-muted);
    transition: transform var(--transition), color var(--transition);
  }

  .card-title {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    line-height: 1.35;
  }

  .card-description {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1rem;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.75rem;
  }

  .card-tags {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .card-tag {
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .card-diff {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    padding: 0.05rem 0.3rem;
    border-radius: 2px;
  }

  .card-diff.beginner {
    color: #4ade80;
  }
  .card-diff.intermediate {
    color: #facc15;
  }
  .card-diff.advanced {
    color: #f87171;
  }
</style>
